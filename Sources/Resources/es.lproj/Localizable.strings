/* 24 Solar Terms — Climate */
"solar.lichun.climate" = "Comienza la primavera. Las temperaturas empiezan a subir, aunque el frío puede volver. Las mañanas heladas dan paso a tardes más cálidas.";
"solar.yushui.climate" = "Aumentan las lluvias a medida que se derrite el hielo invernal. La humedad sube y el aire se siente notablemente más templado.";
"solar.jingzhe.climate" = "El trueno despierta a las criaturas que hibernan. Las temperaturas suben de forma constante, con tormentas primaverales ocasionales.";
"solar.chunfen.climate" = "El día y la noche duran lo mismo. Clima templado y equilibrado con brisas suaves.";
"solar.qingming.climate" = "Cielos despejados y frescos. Una época agradable con calor creciente y vegetación en flor.";
"solar.guyu.climate" = "Pasa la última helada. Lluvias generosas nutren los cultivos recién sembrados.";
"solar.lixia.climate" = "Llega el verano. Aumenta el calor durante el día y las tormentas vespertinas se vuelven frecuentes.";
"solar.xiaoman.climate" = "Los granos empiezan a madurar. Domina el aire cálido y húmedo con chubascos frecuentes.";
"solar.mangzhong.climate" = "El trigo madura y la siembra de verano está en marcha. Se instala un clima caluroso y bochornoso.";
"solar.xiazhi.climate" = "El día más largo del año. El sol está en su punto más alto; el calor se intensifica, aunque los días más calurosos aún están por llegar.";
"solar.xiaoshu.climate" = "El calor aumenta. Clima caluroso y húmedo con tormentas por la tarde.";
"solar.dashu.climate" = "El pico del calor veraniego. El período más caluroso y húmedo del año.";
"solar.liqiu.climate" = "El otoño comienza de nombre, aunque el calor del verano persiste. Las mañanas pueden sentirse un poco más frescas.";
"solar.chushu.climate" = "La época en que «se va el calor». El calor diurno se desvanece y llegan brisas más frescas por la noche.";
"solar.bailu.climate" = "Aparece el rocío matinal a medida que las noches se enfrían rápidamente. El contraste entre las temperaturas del día y de la noche se amplía.";
"solar.qiufen.climate" = "El día y la noche vuelven a durar lo mismo. Clima fresco y agradable con cielos despejados.";
"solar.hanlu.climate" = "Se forma rocío frío. Las temperaturas bajan notablemente y el aire se siente seco y fresco.";
"solar.shuangjang.climate" = "Primera helada en muchas regiones. Mañanas frías y el follaje otoñal en su esplendor.";
"solar.lidong.climate" = "Comienza el invierno. Llegan masas de aire frío; las regiones del norte pueden ver las primeras nieves.";
"solar.xiaoxue.climate" = "Nevadas ligeras en las zonas del norte. Se extienden las condiciones frías y húmedas.";
"solar.daxue.climate" = "Posibles nevadas intensas. Las temperaturas caen en picada y el suelo puede congelarse.";
"solar.dongzhi.climate" = "El día más corto del año. Comienza el frío más profundo, aunque los días irán alargándose poco a poco.";
"solar.xiaohan.climate" = "Se acerca el período más frío. Vientos cortantes y temperaturas bajo cero.";
"solar.dahan.climate" = "La época más fría del año. Frío extremo con aire seco y tormentas de nieve ocasionales.";

/* 24 Solar Terms — Wellness Tips */
"solar.lichun.wellness" = "Nutre tu hígado con verduras de hoja verde. Empieza con estiramientos suaves para dar la bienvenida a la energía yang en ascenso.";
"solar.yushui.wellness" = "Apoya tu bazo con alimentos tibios y fáciles de digerir. Evita los platos fríos y crudos mientras aumenta la humedad.";
"solar.jingzhe.wellness" = "Disipa el estancamiento con ejercicio ligero. Las peras y la miel pueden aliviar la garganta seca.";
"solar.chunfen.wellness" = "Busca el equilibrio en la dieta y la rutina. Una mezcla de calma en interiores y actividad al aire libre es ideal para este equinoccio.";
"solar.qingming.wellness" = "Sal al aire libre: el senderismo y los paseos por la naturaleza levantan el ánimo. Come verduras de temporada como la espinaca.";
"solar.guyu.wellness" = "Bebe mucha agua e infusiones. La sopa de frijol mungo y el té de crisantemo ayudan a manejar la humedad creciente.";
"solar.lixia.wellness" = "Mantén la calma y evita el esfuerzo excesivo. Prefiere alimentos amargos como el melón amargo para disipar el calor interno.";
"solar.xiaoman.wellness" = "Come alimentos ligeros y refrescantes: pepino, sandía y frijol mungo. Mantente hidratada.";
"solar.mangzhong.wellness" = "Tómatelo con calma en el calor. Descansa al mediodía y come comidas fáciles de digerir.";
"solar.xiazhi.wellness" = "Protege tu corazón: evita las bebidas heladas, come alimentos rojos como el tomate y descansa en las horas de mayor calor.";
"solar.xiaoshu.wellness" = "Mantente fresca e hidratada. El arroz hervido ligero y las frutas frescas ayudan a equilibrar el calor del verano.";
"solar.dashu.wellness" = "Prevén el golpe de calor: descansa en interiores al mediodía, bebe agua tibia y evita el esfuerzo intenso.";
"solar.liqiu.wellness" = "Empieza a humedecer tus pulmones: las peras, el lirio y la miel contrarrestan la sequedad del otoño.";
"solar.chushu.wellness" = "Haz la transición de tu dieta de refrescante a caliente. Añade cereales y tubérculos un poco más sustanciosos.";
"solar.bailu.wellness" = "Viste por capas para el frío de la mañana. Las sopas reconfortantes y el arroz hervido protegen los pulmones.";
"solar.qiufen.wellness" = "Equilibra el yin y el yang. El ejercicio moderado y una dieta cálida y variada mantienen el equilibrio.";
"solar.hanlu.wellness" = "Mantén los pies y la zona lumbar abrigados. Las especias que calientan, como el jengibre y la canela, van bien con este frío.";
"solar.shuangjang.wellness" = "Cuida tu estómago: come alimentos tibios y blandos. Los caquis y las castañas están en temporada.";
"solar.lidong.wellness" = "Reserva energía para el invierno: acuéstate temprano y come guisos nutritivos con cordero o pollo.";
"solar.xiaoxue.wellness" = "Los alimentos calientes de cocción lenta, como las sopas, te mantienen con energía. El ejercicio moderado en interiores mantiene el qi fluyendo.";
"solar.daxue.wellness" = "Concéntrate en mantenerte abrigada desde adentro. El sésamo negro, las nueces y las bayas de goji fortalecen la energía de los riñones.";
"solar.dongzhi.wellness" = "El mejor momento para nutrir y restaurar el cuerpo. Disfruta dumplings y hotpot de cordero; protégete del frío.";
"solar.xiaohan.wellness" = "Come comidas calientes y ricas en proteínas. El tai chi o el yoga suaves mantienen la circulación sin agotar las reservas.";
"solar.dahan.wellness" = "Prepárate para el último tramo de frío. Descansa bien, come arroz hervido sustancioso y abrígate bien por capas.";

