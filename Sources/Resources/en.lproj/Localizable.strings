/* 24 Solar Terms — Climate */
"solar.lichun.climate" = "Spring begins. Temperatures start rising but cold spells may return. Icy mornings give way to warmer afternoons.";
"solar.yushui.climate" = "Rainfall increases as winter ice melts. Humidity rises and the air feels noticeably milder.";
"solar.jingzhe.climate" = "Thunder awakens hibernating creatures. Temperatures climb steadily with occasional spring storms.";
"solar.chunfen.climate" = "Day and night are equal. Mild and balanced weather with gentle breezes.";
"solar.qingming.climate" = "Crisp, clear skies. A pleasant period with rising warmth and blooming vegetation.";
"solar.guyu.climate" = "The last frost passes. Generous rainfall nourishes newly planted crops.";
"solar.lixia.climate" = "Summer arrives. Daytime heat increases, and evening thunderstorms become common.";
"solar.xiaoman.climate" = "Grain crops begin to fill. Warm, humid air dominates with frequent showers.";
"solar.mangzhong.climate" = "Wheat ripens and summer planting is underway. Hot and muggy conditions settle in.";
"solar.xiazhi.climate" = "The longest day. Sun is at its highest; heat intensifies though the hottest days are yet to come.";
"solar.xiaoshu.climate" = "Heat builds. Hot and humid weather with afternoon thunderstorms.";
"solar.dashu.climate" = "Peak summer heat. The hottest and most humid period of the year.";
"solar.liqiu.climate" = "Autumn begins in name, though summer heat lingers. Mornings may feel slightly cooler.";
"solar.chushu.climate" = "The 'leaving heat' period. Daytime warmth fades and cooler breezes arrive in the evening.";
"solar.bailu.climate" = "Morning dew appears as nights cool sharply. The contrast between day and night temperatures widens.";
"solar.qiufen.climate" = "Day and night are equal again. Cool, comfortable weather with clear skies.";
"solar.hanlu.climate" = "Cold dew forms. Temperatures drop noticeably and the air feels dry and brisk.";
"solar.shuangjang.climate" = "First frost in many regions. Mornings are chilly and autumn foliage peaks.";
"solar.lidong.climate" = "Winter begins. Cold air masses move in; northern regions may see early snow.";
"solar.xiaoxue.climate" = "Light snowfall in northern areas. Damp, cold conditions spread.";
"solar.daxue.climate" = "Heavy snowfall possible. Temperatures plunge and the ground may freeze.";
"solar.dongzhi.climate" = "The shortest day. Deepest cold begins, though days will slowly lengthen from here.";
"solar.xiaohan.climate" = "Approaching the coldest period. Bitter winds and freezing temperatures.";
"solar.dahan.climate" = "The coldest time of year. Extreme cold with dry air and occasional snowstorms.";

/* 24 Solar Terms — Wellness Tips */
"solar.lichun.wellness" = "Nourish your liver with leafy greens. Start gentle stretching to welcome rising yang energy.";
"solar.yushui.wellness" = "Support your spleen with warm, easy-to-digest foods. Avoid cold and raw dishes as dampness rises.";
"solar.jingzhe.wellness" = "Clear away stagnation with light exercise. Pears and honey can soothe a dry throat.";
"solar.chunfen.wellness" = "Aim for balance in diet and routine. A mix of indoor calm and outdoor activity suits this equinox.";
"solar.qingming.wellness" = "Get outdoors — hiking and nature walks lift the spirit. Eat seasonal greens like spinach.";
"solar.guyu.wellness" = "Drink plenty of water and herbal tea. Mung bean soup and chrysanthemum tea help manage rising dampness.";
"solar.lixia.wellness" = "Stay calm and avoid overexertion. Favor bitter foods like bitter melon to clear internal heat.";
"solar.xiaoman.wellness" = "Eat light, cooling foods — cucumber, watermelon, and mung beans. Keep hydrated.";
"solar.mangzhong.wellness" = "Pace yourself in the heat. Take midday rest and eat easy-to-digest meals.";
"solar.xiazhi.wellness" = "Protect your heart: avoid icy drinks, eat red foods like tomatoes, and rest during peak heat.";
"solar.xiaoshu.wellness" = "Stay cool and hydrated. Light porridge and fresh fruits help balance summer heat.";
"solar.dashu.wellness" = "Prevent heatstroke — rest indoors during midday, drink warm water, and avoid heavy exertion.";
"solar.liqiu.wellness" = "Begin moistening your lungs: pears, lily bulbs, and honey counter autumn dryness.";
"solar.chushu.wellness" = "Transition your diet from cooling to warming. Add slightly richer grains and root vegetables.";
"solar.bailu.wellness" = "Dress in layers for the morning chill. Soothing soups and congee protect the lungs.";
"solar.qiufen.wellness" = "Balance yin and yang. Mild exercise and a warm, varied diet maintain equilibrium.";
"solar.hanlu.wellness" = "Keep feet and lower back warm. Warming spices like ginger and cinnamon suit this chill.";
"solar.shuangjang.wellness" = "Nourish your stomach — eat warm, soft foods. Persimmons and chestnuts are in season.";
"solar.lidong.wellness" = "Store energy for winter: go to bed early and eat nourishing stews with lamb or chicken.";
"solar.xiaoxue.wellness" = "Warm, slow-cooked foods like soups sustain you. Moderate indoor exercise keeps qi flowing.";
"solar.daxue.wellness" = "Focus on keeping warm from the inside. Black sesame, walnuts, and goji berries boost kidney energy.";
"solar.dongzhi.wellness" = "The best time to nourish and restore. Enjoy dumplings and lamb hotpot; protect yourself from cold.";
"solar.xiaohan.wellness" = "Eat warming, high-protein meals. Gentle tai chi or yoga maintains circulation without depleting reserves.";
"solar.dahan.wellness" = "Prepare for the final cold stretch. Rest well, eat hearty porridge, and stay warmly layered.";

