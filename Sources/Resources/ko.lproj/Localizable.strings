/* 24 Solar Terms — Wellness Tips */
"solar.lichun.wellness" = "잎채소로 간을 보살펴 주세요. 솟아오르는 양기를 맞이하며 가벼운 스트레칭을 시작해 보세요.";
"solar.yushui.wellness" = "따뜻하고 소화하기 쉬운 음식으로 비장을 다독여 주세요. 습기가 늘어나니 차갑고 날것인 음식은 피해 주세요.";
"solar.jingzhe.wellness" = "가벼운 운동으로 막힌 기운을 풀어 보세요. 배와 꿀이 건조한 목을 달래 줘요.";
"solar.chunfen.wellness" = "식단과 생활의 균형을 맞춰 보세요. 실내의 차분함과 야외 활동을 고루 섞기 좋은 춘분이에요.";
"solar.qingming.wellness" = "야외로 나가 보세요. 등산과 자연 산책이 기분을 북돋아 줘요. 시금치 같은 제철 채소를 챙겨 드세요.";
"solar.guyu.wellness" = "물과 허브차를 충분히 마셔 보세요. 녹두죽과 국화차가 늘어나는 습기를 다스리는 데 도움이 돼요.";
"solar.lixia.wellness" = "마음을 차분히 하고 무리하지 마세요. 여주 같은 쓴맛 음식이 속열을 내리는 데 좋아요.";
"solar.xiaoman.wellness" = "오이, 수박, 녹두처럼 가볍고 시원한 음식을 드세요. 수분을 충분히 챙기세요.";
"solar.mangzhong.wellness" = "더위 속에서 페이스를 조절하세요. 낮에 잠시 쉬고 소화하기 쉬운 식사를 하세요.";
"solar.xiazhi.wellness" = "심장을 보호하세요. 아이스 음료는 피하고 토마토 같은 붉은 음식을 드시며, 한낮 더위에는 쉬어 주세요.";
"solar.xiaoshu.wellness" = "시원하게 지내고 수분을 챙기세요. 부드러운 죽과 신선한 과일이 여름 더위를 가라앉혀 줘요.";
"solar.dashu.wellness" = "열사병을 조심하세요. 한낮에는 실내에서 쉬고, 따뜻한 물을 마시며 격한 활동은 피해 주세요.";
"solar.liqiu.wellness" = "폐를 촉촉하게 하기 시작해 보세요. 배, 백합, 꿀이 가을 건조함을 달래 줘요.";
"solar.chushu.wellness" = "식단을 시원한 것에서 따뜻한 것으로 바꿔 보세요. 조금 더 든든한 곡물과 뿌리채소를 곁들여 보세요.";
"solar.bailu.wellness" = "아침 쌀쌀함에 겹쳐 입으세요. 따뜻한 국과 죽이 폐를 지켜 줘요.";
"solar.qiufen.wellness" = "음양의 균형을 맞춰 보세요. 가벼운 운동과 따뜻하고 다양한 식단이 균형을 지켜 줘요.";
"solar.hanlu.wellness" = "발과 허리를 따뜻하게 하세요. 생강과 계피 같은 따뜻한 향신료가 이 쌀쌀함에 어울려요.";
"solar.shuangjang.wellness" = "위를 보살펴 주세요. 따뜻하고 부드러운 음식을 드시고, 감과 밤이 제철이에요.";
"solar.lidong.wellness" = "겨울을 위한 에너지를 저장하세요. 일찍 잠들고, 양고기나 닭고기로 끓인 보양식을 즐겨 보세요.";
"solar.xiaoxue.wellness" = "국처럼 따뜻하게 오래 끓인 음식이 몸을 지탱해 줘요. 실내에서 적당히 운동하며 기의 흐름을 유지하세요.";
"solar.daxue.wellness" = "속부터 따뜻하게 하는 데 집중하세요. 흑임자, 호두, 구기자가 신장 기운을 북돋아 줘요.";
"solar.dongzhi.wellness" = "몸을 보하고 회복하기 가장 좋은 때예요. 만두와 양고기 전골을 즐기고 추위를 조심하세요.";
"solar.xiaohan.wellness" = "따뜻하고 단백질이 풍부한 식사를 하세요. 부드러운 태극권이나 요가가 체력 소모 없이 순환을 유지해 줘요.";
"solar.dahan.wellness" = "마지막 추위를 준비하세요. 푹 쉬고 든든한 죽을 먹으며 따뜻하게 겹쳐 입으세요.";

