/* 24 Solar Terms — Climate */
"solar.lichun.climate" = "Le printemps commence. Les températures montent, mais le froid peut revenir. Les matinées glacées cèdent la place à des après-midi plus doux.";
"solar.yushui.climate" = "Les précipitations augmentent à mesure que la glace de l’hiver fond. L’humidité s’accroît et l’air devient nettement plus doux.";
"solar.jingzhe.climate" = "Le tonnerre réveille les créatures en hibernation. Les températures grimpent régulièrement avec des orages printaniers occasionnels.";
"solar.chunfen.climate" = "Le jour et la nuit sont égaux. Un temps doux et équilibré, avec des brises légères.";
"solar.qingming.climate" = "Un ciel clair et pur. Une période agréable, avec une chaleur croissante et une végétation en fleurs.";
"solar.guyu.climate" = "La dernière gelée est passée. Des pluies généreuses nourrissent les cultures nouvellement plantées.";
"solar.lixia.climate" = "L’été arrive. La chaleur diurne s’intensifie et les orages du soir deviennent fréquents.";
"solar.xiaoman.climate" = "Les grains commencent à se remplir. Un air chaud et humide domine, avec des averses fréquentes.";
"solar.mangzhong.climate" = "Le blé mûrit et les semis d’été battent leur plein. Une chaleur lourde et moite s’installe.";
"solar.xiazhi.climate" = "Le jour le plus long. Le soleil est à son zénith ; la chaleur s’intensifie, bien que les journées les plus chaudes soient encore à venir.";
"solar.xiaoshu.climate" = "La chaleur s’installe. Un temps chaud et humide avec des orages en après-midi.";
"solar.dashu.climate" = "Le pic de la chaleur estivale. La période la plus chaude et la plus humide de l’année.";
"solar.liqiu.climate" = "L’automne commence de nom, même si la chaleur estivale persiste. Les matinées peuvent être légèrement plus fraîches.";
"solar.chushu.climate" = "La période de la « fin des chaleurs ». La chaleur diurne s’estompe et des brises plus fraîches arrivent le soir.";
"solar.bailu.climate" = "La rosée du matin apparaît tandis que les nuits se rafraîchissent nettement. L’écart de température entre le jour et la nuit se creuse.";
"solar.qiufen.climate" = "Le jour et la nuit sont à nouveau égaux. Un temps frais et confortable sous un ciel dégagé.";
"solar.hanlu.climate" = "La rosée froide se forme. Les températures chutent sensiblement et l’air devient sec et vif.";
"solar.shuangjang.climate" = "Premières gelées dans de nombreuses régions. Les matinées sont froides et le feuillage d’automne est à son apogée.";
"solar.lidong.climate" = "L’hiver commence. Des masses d’air froid s’installent ; les régions du nord peuvent voir les premières neiges.";
"solar.xiaoxue.climate" = "Légères chutes de neige dans le nord. Un temps humide et froid se généralise.";
"solar.daxue.climate" = "Chutes de neige abondantes possibles. Les températures plongent et le sol peut geler.";
"solar.dongzhi.climate" = "Le jour le plus court. Le froid le plus intense commence, même si les journées vont lentement rallonger.";
"solar.xiaohan.climate" = "La période la plus froide approche. Vents mordants et températures glaciales.";
"solar.dahan.climate" = "La période la plus froide de l’année. Froid extrême, air sec et tempêtes de neige occasionnelles.";

/* 24 Solar Terms — Wellness Tips */
"solar.lichun.wellness" = "Nourrissez votre foie avec des légumes verts feuillus. Commencez des étirements doux pour accueillir l’énergie yang ascendante.";
"solar.yushui.wellness" = "Soutenez votre rate avec des aliments chauds et faciles à digérer. Évitez les plats froids et crus pendant que l’humidité s’installe.";
"solar.jingzhe.wellness" = "Dissipez les stagnations par un exercice léger. Les poires et le miel apaisent la gorge sèche.";
"solar.chunfen.wellness" = "Visez l’équilibre dans l’alimentation et la routine. Un mélange de calme intérieur et d’activité extérieure convient à cet équinoxe.";
"solar.qingming.wellness" = "Sortez dehors — randonnées et promenades en nature élèvent l’esprit. Mangez des légumes verts de saison comme les épinards.";
"solar.guyu.wellness" = "Buvez beaucoup d’eau et de tisanes. La soupe de haricots mungo et le thé au chrysanthème aident à gérer l’humidité croissante.";
"solar.lixia.wellness" = "Restez calme et évitez le surmenage. Privilégiez les aliments amers comme la margose pour dissiper la chaleur interne.";
"solar.xiaoman.wellness" = "Mangez léger et rafraîchissant — concombre, pastèque et haricots mungo. Restez bien hydratée.";
"solar.mangzhong.wellness" = "Ménagez-vous dans la chaleur. Accordez-vous une pause à midi et mangez des repas faciles à digérer.";
"solar.xiazhi.wellness" = "Protégez votre cœur : évitez les boissons glacées, mangez des aliments rouges comme les tomates et reposez-vous aux heures les plus chaudes.";
"solar.xiaoshu.wellness" = "Restez au frais et hydratée. Des porridges légers et des fruits frais aident à équilibrer la chaleur estivale.";
"solar.dashu.wellness" = "Prévenez les coups de chaleur — reposez-vous à l’intérieur à midi, buvez de l’eau tiède et évitez les efforts intenses.";
"solar.liqiu.wellness" = "Commencez à humidifier vos poumons : poires, bulbes de lys et miel contre la sécheresse automnale.";
"solar.chushu.wellness" = "Faites passer votre alimentation du rafraîchissant au réchauffant. Ajoutez des céréales un peu plus riches et des légumes-racines.";
"solar.bailu.wellness" = "Habillez-vous en couches pour les matinées fraîches. Soupes et congees réconfortants protègent les poumons.";
"solar.qiufen.wellness" = "Équilibrez le yin et le yang. Un exercice modéré et une alimentation chaude et variée maintiennent l’équilibre.";
"solar.hanlu.wellness" = "Gardez les pieds et le bas du dos au chaud. Les épices réchauffantes comme le gingembre et la cannelle conviennent à cette fraîcheur.";
"solar.shuangjang.wellness" = "Nourrissez votre estomac — mangez des aliments chauds et moelleux. Les kakis et les châtaignes sont de saison.";
"solar.lidong.wellness" = "Stockez de l’énergie pour l’hiver : couchez-vous tôt et mangez des ragoûts nourrissants d’agneau ou de poulet.";
"solar.xiaoxue.wellness" = "Les plats chauds mijotés comme les soupes vous soutiennent. Un exercice modéré en intérieur maintient la circulation du qi.";
"solar.daxue.wellness" = "Concentrez-vous sur la chaleur intérieure. Le sésame noir, les noix et les baies de goji renforcent l’énergie des reins.";
"solar.dongzhi.wellness" = "Le meilleur moment pour nourrir et restaurer. Savourez des raviolis et une fondue d’agneau ; protégez-vous du froid.";
"solar.xiaohan.wellness" = "Mangez des repas chauds et riches en protéines. Un tai-chi ou un yoga doux maintient la circulation sans épuiser vos réserves.";
"solar.dahan.wellness" = "Préparez-vous à la dernière vague de froid. Reposez-vous bien, mangez un porridge copieux et restez bien couverte.";

