/* 24 Solar Terms — Climate */
"solar.lichun.climate" = "春季开始，气温回升但仍有倒春寒。早晚温差大，午后渐暖。";
"solar.yushui.climate" = "冰雪消融，降水渐增，空气明显回暖，湿度上升。";
"solar.jingzhe.climate" = "春雷始鸣，万物复苏。气温稳步上升，偶有春季雷阵雨。";
"solar.chunfen.climate" = "昼夜等长，气候温和宜人，春风和煦。";
"solar.qingming.climate" = "天清气朗，草木繁茂，气温舒适宜人。";
"solar.guyu.climate" = "终霜已过，雨量充沛，滋润春播作物。";
"solar.lixia.climate" = "夏季来临，白天渐热，傍晚雷阵雨增多。";
"solar.xiaoman.climate" = "作物灌浆渐满，暖湿气流主导，阵雨频繁。";
"solar.mangzhong.climate" = "小麦成熟、夏播开始。闷热潮湿的天气定型。";
"solar.xiazhi.climate" = "日照最长，阳光最烈；虽已入盛夏，但最热的日子尚在后头。";
"solar.xiaoshu.climate" = "暑气渐盛，闷热多雨，午后常有雷阵雨。";
"solar.dashu.climate" = "一年中最热最潮湿的时段，高温高湿持续。";
"solar.liqiu.climate" = "名义上入秋，暑热犹存。清晨可能略感凉意。";
"solar.chushu.climate" = "暑气消退，白天余热渐散，夜间清风徐来。";
"solar.bailu.climate" = "夜凉显著，晨间露水初现。昼夜温差加大。";
"solar.qiufen.climate" = "再次昼夜等长，秋高气爽，天朗气清。";
"solar.hanlu.climate" = "寒露凝结，气温明显下降，空气干爽清冽。";
"solar.shuangjang.climate" = "多地初霜，早晨寒凉，秋叶正盛。";
"solar.lidong.climate" = "冬季开始，冷空气南下；北方可能迎来初雪。";
"solar.xiaoxue.climate" = "北方小雪飘落，阴冷潮湿蔓延。";
"solar.daxue.climate" = "可能出现大雪，气温骤降，地面冰冻。";
"solar.dongzhi.climate" = "白昼最短，严寒正式开始；此后日照将缓慢回升。";
"solar.xiaohan.climate" = "临近全年最冷时段，寒风凛冽，天寒地冻。";
"solar.dahan.climate" = "全年最冷，极端低温，空气干燥，偶有暴雪。";

/* 24 Solar Terms — Wellness Tips */
"solar.lichun.wellness" = "养肝护肝，多吃绿叶蔬菜。开始温和拉伸，迎接阳气生发。";
"solar.yushui.wellness" = "健脾祛湿，多吃温热易消化的食物，少吃生冷。";
"solar.jingzhe.wellness" = "疏肝解郁，适当轻运动。梨和蜂蜜可润喉养肺。";
"solar.chunfen.wellness" = "饮食作息讲求平衡。室内静养与户外活动交替进行。";
"solar.qingming.wellness" = "踏青出游，登山散步舒畅身心。应季蔬菜如菠菜正当时。";
"solar.guyu.wellness" = "多饮水和花草茶。绿豆汤、菊花茶帮助应对上升的湿气。";
"solar.lixia.wellness" = "心静自然凉，避免过劳。苦瓜等苦味食物可清心火。";
"solar.xiaoman.wellness" = "饮食清淡：黄瓜、西瓜、绿豆消暑。注意补水。";
"solar.mangzhong.wellness" = "暑热中注意节奏，午间小憩，饮食易消化为主。";
"solar.xiazhi.wellness" = "养心为要：少喝冰饮，多吃番茄等红色食物，避开正午烈日。";
"solar.xiaoshu.wellness" = "防暑降温，清粥水果平衡暑热，注意补充水分。";
"solar.dashu.wellness" = "谨防中暑：午间休息，饮温水，减少剧烈运动。";
"solar.liqiu.wellness" = "开始润肺：梨、百合、蜂蜜抵御秋燥。";
"solar.chushu.wellness" = "饮食从清凉过渡到温补，增加杂粮和根茎类蔬菜。";
"solar.bailu.wellness" = "早晚添衣注意保暖。温润汤粥养护肺气。";
"solar.qiufen.wellness" = "阴阳平衡，温和运动加均衡饮食维持身体平衡。";
"solar.hanlu.wellness" = "注意足部和腰部保暖。生姜、肉桂等温性香料适合此时。";
"solar.shuangjang.wellness" = "养护脾胃，多吃温软食物。柿子、板栗正当季。";
"solar.lidong.wellness" = "冬藏养生：早睡补眠，炖煮羊肉或鸡汤温补身体。";
"solar.xiaoxue.wellness" = "温热慢炖汤品滋养身体，适度室内运动保持气血流通。";
"solar.daxue.wellness" = "注重内在保暖：黑芝麻、核桃、枸杞补肾养元气。";
"solar.dongzhi.wellness" = "最佳滋补时节。饺子、羊肉火锅暖身；注意防寒保暖。";
"solar.xiaohan.wellness" = "高蛋白温补饮食。太极或瑜伽保持循环而不损耗元气。";
"solar.dahan.wellness" = "迎接最后的严寒。充分休息，温热粥品养胃，注意多层穿衣。";

