      "context_preset": "menstrual_day2_cramps",
      "profile_preset": "runner_yoga_cramps_history",
      "acceptance": {
        "must_include_any": [
          ["低强度", "温和", "舒缓", "降低强度"],
          ["瑜伽", "拉伸", "散步", "步行", "休息"]
