# DeepSeek API key (required)
DEEPSEEK_API_KEY=sk-your-api-key-here

# Shared secret for iOS app authentication. Keep enabled for private clients.
# Generate with: openssl rand -hex 32
APP_TOKEN=your-64-char-hex-token-here

# Allow iOS clients without X-App-Token. Use only with rate limiting enabled.
ALLOW_UNAUTHENTICATED_APP=0
UNAUTH_RATE_LIMIT_PER_MINUTE=12

# Server listen address (optional, default :8080)
LISTEN_ADDR=:8080
